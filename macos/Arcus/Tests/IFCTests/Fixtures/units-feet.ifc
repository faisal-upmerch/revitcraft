#9=IFCCARTESIANPOINT((0.,0.,0.));
#10=IFCAXIS2PLACEMENT3D(#9,$,$);
#11=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#10,$);
#12=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#11,$,.MODEL_VIEW.,$);
#13=IFCPROJECT('0ArcusFixturesProjFeet',$,'Feet Project',$,$,$,$,(#11),#8);
#14=IFCCARTESIANPOINT((100.,0.,0.));
#15=IFCAXIS2PLACEMENT3D(#14,$,$);
#16=IFCLOCALPLACEMENT($,#15);
#17=IFCSITE('0ArcusFixturesSiteFeet',$,'Site',$,$,#16,$,$,.ELEMENT.,$,$,$,$,$);
#18=IFCCARTESIANPOINT((0.,50.,0.));
#19=IFCDIRECTION((0.,0.,1.));
#20=IFCDIRECTION((0.,1.,0.));
#21=IFCAXIS2PLACEMENT3D(#18,#19,#20);
#22=IFCLOCALPLACEMENT(#16,#21);
#23=IFCBUILDING('0ArcusFixturesBldgFeet',$,'Building',$,$,#22,$,$,.ELEMENT.,$,$,$);
#24=IFCCARTESIANPOINT((0.,0.,10.));
#25=IFCAXIS2PLACEMENT3D(#24,$,$);
#26=IFCLOCALPLACEMENT(#22,#25);
#27=IFCBUILDINGSTOREY('0ArcusFixturesStorFeet',$,'Level 10ft',$,$,#26,$,$,.ELEMENT.,10.);
#28=IFCCARTESIANPOINT((10.,0.,0.));
#29=IFCAXIS2PLACEMENT3D(#28,$,$);
#30=IFCLOCALPLACEMENT(#26,#29);
#31=IFCBLOCK(#10,10.,5.,2.);
#32=IFCSHAPEREPRESENTATION(#12,'Body','CSG',(#31));
#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#32));
#34=IFCBUILDINGELEMENTPROXY('0ArcusFixturesBoxFeet1',$,'Crate',$,$,#30,#33,$,$);
#35=IFCRELAGGREGATES('0ArcusFixturesRelAFeet',$,$,$,#13,(#17));
#36=IFCRELAGGREGATES('0ArcusFixturesRelBFeet',$,$,$,#17,(#23));
#37=IFCRELAGGREGATES('0ArcusFixturesRelCFeet',$,$,$,#23,(#27));
#38=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ArcusFixturesRelDFeet',$,$,$,(#34),#27);
ENDSEC;
