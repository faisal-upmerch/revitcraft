ISO-10303-21;
HEADER;
/* Hand-written Arcus test fixture (CC0). IFC4 with conversion-based FOOT length unit and a placement chain. */
FILE_DESCRIPTION(('ViewDefinition [ReferenceView_V1.2]'),'2;1');
FILE_NAME('units-feet.ifc','2026-01-01T00:00:00',(''),(''),'hand written','hand written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);
#3=IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(0.3048),#1);
#4=IFCCONVERSIONBASEDUNIT(#2,.LENGTHUNIT.,'FOOT',#3);
#5=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#6=IFCMEASUREWITHUNIT(IFCPLANEANGLEMEASURE(0.0174532925199433),#5);
#7=IFCCONVERSIONBASEDUNIT(#2,.PLANEANGLEUNIT.,'DEGREE',#6);
