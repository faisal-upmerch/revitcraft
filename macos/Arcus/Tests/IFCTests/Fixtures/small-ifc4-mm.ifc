#22=IFCRELAGGREGATES('0ArcusFixturesRelA0002',$,$,$,#12,(#14));
#23=IFCRELAGGREGATES('0ArcusFixturesRelA0003',$,$,$,#14,(#16,#20));
/* Wall: 6000 x 200 x 3000 mm, axis along +X starting at (1000,2000). */
#30=IFCCARTESIANPOINT((1000.,2000.,0.));
#31=IFCAXIS2PLACEMENT3D(#30,$,$);
#32=IFCLOCALPLACEMENT(#15,#31);
#33=IFCCARTESIANPOINT((0.,0.));
