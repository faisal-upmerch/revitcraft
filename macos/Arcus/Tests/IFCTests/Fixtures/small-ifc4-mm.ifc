#8=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Axis','Model',*,*,*,*,#6,$,.GRAPH_VIEW.,$);
#10=IFCPROJECT('0ArcusFixturesProj0001',$,'Hand Project',$,$,$,$,(#6),#3);
#11=IFCLOCALPLACEMENT($,#5);
#12=IFCSITE('0ArcusFixturesSite0001',$,'Site',$,$,#11,$,$,.ELEMENT.,$,$,$,$,$);
#13=IFCLOCALPLACEMENT(#11,#5);
#14=IFCBUILDING('0ArcusFixturesBldg0001',$,'Building',$,$,#13,$,$,.ELEMENT.,$,$,$);
#15=IFCLOCALPLACEMENT(#13,#5);
#16=IFCBUILDINGSTOREY('0ArcusFixturesStor0001',$,'Ground Floor',$,$,#15,$,$,.ELEMENT.,0.);
#17=IFCCARTESIANPOINT((0.,0.,3500.));
