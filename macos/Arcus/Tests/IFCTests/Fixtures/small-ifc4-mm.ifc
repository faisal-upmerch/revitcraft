#72=IFCEXTRUDEDAREASOLID(#71,#5,#40,2100.);
#73=IFCSHAPEREPRESENTATION(#7,'Body','SweptSolid',(#72));
#74=IFCPRODUCTDEFINITIONSHAPE($,$,(#73));
#75=IFCDOOR('0ArcusFixturesDoor0001',$,'Entrance',$,$,#70,#74,'D-1',2100.,900.,.DOOR.,.SINGLE_SWING_LEFT.,$);
#76=IFCRELFILLSELEMENT('0ArcusFixturesRelF0001',$,$,$,#68,#75);
/* Floor slab 6000 x 4000 x 200 mm with an indexed poly curve profile, top at storey level. */
#80=IFCCARTESIANPOINTLIST2D(((0.,0.),(6000.,0.),(6000.,4000.),(0.,4000.)));
#81=IFCINDEXEDPOLYCURVE(#80,(IFCLINEINDEX((1,2,3,4,1))),.F.);
#82=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#81);
#83=IFCCARTESIANPOINT((0.,0.,-200.));
#84=IFCAXIS2PLACEMENT3D(#83,$,$);
#85=IFCEXTRUDEDAREASOLID(#82,#84,#40,200.);
#86=IFCSHAPEREPRESENTATION(#7,'Body','SweptSolid',(#85));
#87=IFCPRODUCTDEFINITIONSHAPE($,$,(#86));
#88=IFCLOCALPLACEMENT(#15,#31);
#89=IFCSLAB('0ArcusFixturesSlab0001',$,'Ground Slab',$,$,#88,#87,$,.FLOOR.);
/* Space 4000 x 3000 x 2700 mm. */
#90=IFCCARTESIANPOINT((1000.,2100.,0.));
#91=IFCAXIS2PLACEMENT3D(#90,$,$);
#92=IFCLOCALPLACEMENT(#15,#91);
#93=IFCCARTESIANPOINT((4000.,0.));
#94=IFCCARTESIANPOINT((4000.,3000.));
#95=IFCCARTESIANPOINT((0.,3000.));
#96=IFCPOLYLINE((#33,#93,#94,#95,#33));
#97=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#96);
#98=IFCEXTRUDEDAREASOLID(#97,#5,#40,2700.);
#99=IFCSHAPEREPRESENTATION(#7,'Body','SweptSolid',(#98));
#100=IFCPRODUCTDEFINITIONSHAPE($,$,(#99));
#101=IFCSPACE('0ArcusFixturesSpac0001',$,'R1',$,$,#92,#100,'Kitchen',.ELEMENT.,.SPACE.,$);
#102=IFCRELAGGREGATES('0ArcusFixturesRelA0004',$,$,$,#16,(#101));
/* Upper floor: a CSG block proxy and a clipped proxy. */
#110=IFCCARTESIANPOINT((2000.,3000.,0.));
#111=IFCAXIS2PLACEMENT3D(#110,$,$);
#112=IFCLOCALPLACEMENT(#19,#111);
#113=IFCBLOCK(#5,500.,400.,300.);
#114=IFCCSGSOLID(#113);
#115=IFCSHAPEREPRESENTATION(#7,'Body','CSG',(#114));
#116=IFCPRODUCTDEFINITIONSHAPE($,$,(#115));
#117=IFCBUILDINGELEMENTPROXY('0ArcusFixturesProx0001',$,'Planter',$,'Planter Box',#112,#116,$,.NOTDEFINED.);
#120=IFCPLANE(#5);
#121=IFCHALFSPACESOLID(#120,.F.);
#122=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#41,#121);
#123=IFCSHAPEREPRESENTATION(#7,'Body','Clipping',(#122));
#124=IFCPRODUCTDEFINITIONSHAPE($,$,(#123));
#125=IFCLOCALPLACEMENT(#19,#5);
#126=IFCBUILDINGELEMENTPROXY('0ArcusFixturesProx0002',$,'Clipped Panel',$,$,#125,#124,$,.NOTDEFINED.);
#130=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ArcusFixturesRelC0001',$,$,$,(#44,#75,#89),#16);
#131=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ArcusFixturesRelC0002',$,$,$,(#117,#126),#20);
ENDSEC;
END-ISO-10303-21;
