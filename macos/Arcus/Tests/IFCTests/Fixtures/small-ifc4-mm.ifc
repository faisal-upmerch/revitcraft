#35=IFCPOLYLINE((#33,#34));
#36=IFCSHAPEREPRESENTATION(#8,'Axis','Curve2D',(#35));
#37=IFCCARTESIANPOINT((3000.,0.));
#38=IFCAXIS2PLACEMENT2D(#37,$);
#39=IFCRECTANGLEPROFILEDEF(.AREA.,$,#38,6000.,200.);
#40=IFCDIRECTION((0.,0.,1.));
#41=IFCEXTRUDEDAREASOLID(#39,#5,#40,3000.);
#42=IFCSHAPEREPRESENTATION(#7,'Body','SweptSolid',(#41));
#43=IFCPRODUCTDEFINITIONSHAPE($,$,(#36,#42));
#44=IFCWALL('0ArcusFixturesWall0001',$,'South Wall',$,$,#32,#43,'W-7',.STANDARD.);
#45=IFCMATERIAL('Concrete',$,'Concrete');
#46=IFCMATERIALLAYER(#45,200.,$,'Concrete','Structure [1]','LoadBearing',$);
#47=IFCMATERIALLAYERSET((#46),'Concrete 200',$);
#48=IFCMATERIALLAYERSETUSAGE(#47,.AXIS2.,.NEGATIVE.,100.,$);
#49=IFCRELASSOCIATESMATERIAL('0ArcusFixturesRelM0001',$,$,$,(#44),#48);
#50=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#51=IFCPROPERTYSINGLEVALUE('LoadBearing',$,IFCBOOLEAN(.T.),$);
#52=IFCPROPERTYSINGLEVALUE('Height',$,IFCLENGTHMEASURE(3000.),$);
#53=IFCPROPERTYSET('0ArcusFixturesPset0001',$,'Pset_WallCommon',$,(#50,#51,#52));
#54=IFCRELDEFINESBYPROPERTIES('0ArcusFixturesRelP0001',$,$,$,(#44),#53);
/* Opening 1000 x 2100 centred at station 2500, and the door filling it. */
#60=IFCCARTESIANPOINT((2500.,0.,0.));
#61=IFCAXIS2PLACEMENT3D(#60,$,$);
#62=IFCLOCALPLACEMENT(#32,#61);
#63=IFCAXIS2PLACEMENT2D(#33,$);
#64=IFCRECTANGLEPROFILEDEF(.AREA.,$,#63,1000.,300.);
#65=IFCEXTRUDEDAREASOLID(#64,#5,#40,2100.);
#66=IFCSHAPEREPRESENTATION(#7,'Body','SweptSolid',(#65));
#67=IFCPRODUCTDEFINITIONSHAPE($,$,(#66));
#68=IFCOPENINGELEMENT('0ArcusFixturesOpen0001',$,'Opening',$,$,#62,#67,$,.OPENING.);
#69=IFCRELVOIDSELEMENT('0ArcusFixturesRelV0001',$,$,$,#44,#68);
#70=IFCLOCALPLACEMENT(#62,#5);
